# --- The Torts Attorney - Environment Variables ---

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://thetortsattorney.com
NEXT_PUBLIC_SITE_NAME=The Torts Attorney

# Contact Form - Resend Email Service
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email address to receive contact form submissions
CONTACT_NOTIFICATION_EMAIL=hello@thetortsattorney.com

# From email address (must be a verified sending domain in Resend)
FROM_EMAIL=The Torts Attorney <contact@thetortsattorney.com>

# Analytics - Plausible (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Analytics - Google Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Rate Limiting - Upstash Redis (optional, falls back to in-memory)
# Get yours at https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot Protection - Cloudflare Turnstile (optional, skips verification if not set)
# Get yours at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Search Engine Verification (optional)
# Get from Google Search Console > Settings > Verification
GOOGLE_SITE_VERIFICATION=
# Get from Bing Webmaster Tools
BING_SITE_VERIFICATION=
